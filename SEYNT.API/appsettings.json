{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=SeyntDb;Username=postgres;Password=postgres"
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "Jwt": {
    "Secret": "Seynt_Super_Secret_Key_For_Development_Must_Be_Long_Enough_2026!",
    "Issuer": "SeyntAPI",
    "Audience": "SeyntClient",
    "ExpiryMinutes": 60
  },
  "Encryption": {
    "Key": "Seynt_Encryption_Secret_Key_At_Rest_32chars!"
  }
}
